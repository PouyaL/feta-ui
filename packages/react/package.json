{
  "name": "@fetaui/react",
  "version": "0.0.0",
  "description": "Animated React icons: the Free set in 10 styles.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "exports": {
    "./lib": "./src/lib/index.ts",
    "./rounded": "./src/rounded/index.ts",
    "./rounded/*": "./src/rounded/*.tsx",
    "./outlined": "./src/outlined/index.ts",
    "./outlined/*": "./src/outlined/*.tsx",
    "./filled": "./src/filled/index.ts",
    "./filled/*": "./src/filled/*.tsx",
    "./sharp": "./src/sharp/index.ts",
    "./sharp/*": "./src/sharp/*.tsx",
    "./two-tone": "./src/two-tone/index.ts",
    "./two-tone/*": "./src/two-tone/*.tsx",
    "./hand-drawn": "./src/hand-drawn/index.ts",
    "./hand-drawn/*": "./src/hand-drawn/*.tsx",
    "./riso": "./src/riso/index.ts",
    "./riso/*": "./src/riso/*.tsx",
    "./pixel": "./src/pixel/index.ts",
    "./pixel/*": "./src/pixel/*.tsx",
    "./glass": "./src/glass/index.ts",
    "./glass/*": "./src/glass/*.tsx",
    "./neon": "./src/neon/index.ts",
    "./neon/*": "./src/neon/*.tsx"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./lib": {
        "types": "./dist/types/lib/index.d.ts",
        "import": "./dist/esm/lib/index.js",
        "require": "./dist/cjs/lib/index.js"
      },
      "./rounded": {
        "types": "./dist/types/rounded/index.d.ts",
        "import": "./dist/esm/rounded/index.js",
        "require": "./dist/cjs/rounded/index.js"
      },
      "./rounded/*": {
        "types": "./dist/types/rounded/*.d.ts",
        "import": "./dist/esm/rounded/*.js",
        "require": "./dist/cjs/rounded/*.js"
      },
      "./outlined": {
        "types": "./dist/types/outlined/index.d.ts",
        "import": "./dist/esm/outlined/index.js",
        "require": "./dist/cjs/outlined/index.js"
      },
      "./outlined/*": {
        "types": "./dist/types/outlined/*.d.ts",
        "import": "./dist/esm/outlined/*.js",
        "require": "./dist/cjs/outlined/*.js"
